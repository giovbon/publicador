{% set isPost = page.inputPath and "src/posts/" in page.inputPath %}
{% set canonical = site.url + page.url %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} — {{ site.role }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="author" content="{{ site.author }}">
<meta name="generator" content="Eleventy">
{% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<meta name="robots" content="index, follow">{% endif %}
<link rel="canonical" href="{{ canonical }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#0f0f10">

<script>
  (() => {
    try {
      const saved = localStorage.getItem("tema");
      if (saved === "claro" || saved === "escuro") {
        document.documentElement.dataset.theme = saved === "claro" ? "light" : "dark";
      }
    } catch (_) {}
  })();
</script>

<link rel="preload" href="/assets/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/main.css">

<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
<meta property="og:locale" content="pt_BR">
<meta property="og:image" content="{{ site.url }}/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.title }} — {{ site.description }}">
{% if isPost %}<meta property="article:published_time" content="{{ date | isoDate }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or site.title }}">
<meta name="twitter:description" content="{{ description or site.description }}">
<meta name="twitter:image" content="{{ site.url }}/og.png">

{% if isPost %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ (updated or date) | isoDate }}",
  "url": "{{ canonical }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ canonical }}" },
  "author": { "@type": "Person", "name": {{ site.author | dump | safe }}, "url": {{ site.url | dump | safe }} },
  "publisher": { "@type": "Person", "name": {{ site.author | dump | safe }} },
  "inLanguage": "pt-BR"
}
</script>
{% else %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site.title | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "inLanguage": "pt-BR",
  "author": { "@type": "Person", "name": {{ site.author | dump | safe }} }
}
</script>
{% endif %}
