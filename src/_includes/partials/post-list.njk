<ol class="post-list">
  {% for post in posts %}
    <li class="post-item">
      <a class="post-item-link" href="{{ post.url }}">
        <time class="post-item-date" datetime="{{ post.date | isoDate }}">{{ post.date | shortDate }}</time>
        <div class="post-item-body">
          <h3 class="post-item-title">{{ post.data.title }}</h3>
          {% if post.data.description %}
            <p class="post-item-desc">{{ post.data.description }}</p>
          {% endif %}
          {% if post.data.tags and post.data.tags.length %}
            <span class="tag-list" aria-hidden="true">
              {% for tag in post.data.tags %}
                {% if tag != "posts" %}<span>{{ tag }}</span>{% endif %}
              {% endfor %}
            </span>
          {% endif %}
        </div>
        <span class="post-item-arrow" aria-hidden="true">→</span>
      </a>
    </li>
  {% endfor %}
</ol>
